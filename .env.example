# Server-side Gemini API key for AI chat & smart promotion features
GEMINI_API_KEY=

# Production Runtime Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Optional Telegram API Credentials Override
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Logging & Observability
LOG_STRUCTURED=true
LOG_LEVEL=info
DISABLE_PII_MASKING=false
METRICS_ENABLED=true

# Reliability & Circuit Breaker Thresholds
API_TIMEOUT_MS=30000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=30000
MAX_CONCURRENT_TURNS=500
